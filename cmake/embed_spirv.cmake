if(NOT DEFINED OUTPUT_HEADER
        OR NOT DEFINED SPIRV_FILES
        OR NOT DEFINED SYMBOLS)
    message(FATAL_ERROR "SPIR-V inputs, symbols and output are required")
endif()

string(REPLACE "|" ";" SPIRV_FILES "${SPIRV_FILES}")
string(REPLACE "|" ";" SYMBOLS "${SYMBOLS}")

list(LENGTH SPIRV_FILES file_count)
list(LENGTH SYMBOLS symbol_count)
if(NOT file_count EQUAL symbol_count)
    message(FATAL_ERROR "SPIR-V file and symbol counts differ")
endif()

set(header "#pragma once\n\n#include <array>\n#include <cstdint>\n\nnamespace hw3d::shaders {\n\n")
math(EXPR last_index "${file_count} - 1")
foreach(index RANGE 0 ${last_index})
    list(GET SPIRV_FILES ${index} shader_file)
    list(GET SYMBOLS ${index} symbol)
    file(SIZE "${shader_file}" shader_size)
    math(EXPR remainder "${shader_size} % 4")
    if(NOT remainder EQUAL 0)
        message(FATAL_ERROR "${shader_file} size is not a multiple of four")
    endif()
    file(READ "${shader_file}" shader_hex HEX)
    string(REGEX MATCHALL "........" words "${shader_hex}")
    math(EXPR word_count "${shader_size} / 4")
    string(APPEND header
        "inline constexpr std::array<std::uint32_t, ${word_count}> ${symbol}{\n")
    foreach(word IN LISTS words)
        string(SUBSTRING "${word}" 0 2 b0)
        string(SUBSTRING "${word}" 2 2 b1)
        string(SUBSTRING "${word}" 4 2 b2)
        string(SUBSTRING "${word}" 6 2 b3)
        string(APPEND header "    0x${b3}${b2}${b1}${b0}u,\n")
    endforeach()
    string(APPEND header "};\n\n")
endforeach()
string(APPEND header "} // namespace hw3d::shaders\n")

get_filename_component(output_directory "${OUTPUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT_HEADER}" "${header}")
